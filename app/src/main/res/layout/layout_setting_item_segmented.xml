<?xml version="1.0" encoding="utf-8"?>
<com.andrerinas.headunitrevived.view.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:glassCornerRadius="@dimen/glass_radius_card"
    app:glassBlur="15">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/settingName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Wireless Mode" />

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/settingName"
            app:layout_constraintEnd_toEndOf="parent">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOption1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="@dimen/glass_radius_button"
                app:strokeColor="@color/segmented_button_stroke_selector"
                android:checkable="true"
                tools:text="Helper" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOption2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="@dimen/glass_radius_button"
                app:strokeColor="@color/segmented_button_stroke_selector"
                android:checkable="true"
                tools:text="Native" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOption3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="@dimen/glass_radius_button"
                app:strokeColor="@color/segmented_button_stroke_selector"
                android:checkable="true"
                tools:text="Server" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.andrerinas.headunitrevived.view.GlassView>
