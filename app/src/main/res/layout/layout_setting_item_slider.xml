<?xml version="1.0" encoding="utf-8"?>
<com.andrerinas.headunitrevived.view.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:glassCornerRadius="@dimen/glass_radius_card"
    app:glassBlur="15">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/settingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Stability timeout" />

        <TextView
            android:id="@+id/settingValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_second"
            android:textSize="14sp"
            tools:text="10 s" />

        <com.google.android.material.slider.Slider
            android:id="@+id/settingSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="gone"
            app:thumbColor="@color/brand_teal"
            app:trackColorActive="@color/brand_teal" />

    </LinearLayout>
</com.andrerinas.headunitrevived.view.GlassView>
