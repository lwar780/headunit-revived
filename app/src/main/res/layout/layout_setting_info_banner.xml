<?xml version="1.0" encoding="utf-8"?>
<com.andrerinas.headunitrevived.view.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:glassCornerRadius="@dimen/glass_radius_card"
    app:glassBlur="10"
    app:glassState="active">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/text_primary"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textStyle="italic"
            tools:text="Info banner text" />

    </LinearLayout>
</com.andrerinas.headunitrevived.view.GlassView>
